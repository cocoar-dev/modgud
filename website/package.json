{
  "name": "cocoar-auth-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "dev:in-app": "vitepress dev --config .vitepress/config.in-app.ts",
    "build:in-app": "vitepress build --config .vitepress/config.in-app.ts",
    "preview:in-app": "vitepress preview --config .vitepress/config.in-app.ts",
    "build:all": "pnpm build && pnpm build:in-app",
    "export:md": "node scripts/export-md.mjs",
    "export:pdf": "node scripts/export-pdf.mjs"
  },
  "devDependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.13.0",
    "puppeteer-core": "^24.39.1",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "latest",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
