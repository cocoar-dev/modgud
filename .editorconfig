# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{cs,csx}]
indent_style = tab

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{js,ts,jsx,tsx,html,css,scss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
