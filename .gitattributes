# Auto-detect text files and normalise to LF in the repo. Avoids the
# Windows-vs-Linux CRLF churn that produces noisy diffs across machines.
* text=auto eol=lf

# Text files — explicit so future contributors don't have to reason about
# auto-detection.
*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.props     text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.vue       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf
*.editorconfig text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
Dockerfile  text eol=lf
LICENSE     text eol=lf
NOTICE      text eol=lf

# Shell scripts and entrypoints — must stay LF even on Windows checkouts.
*.sh        text eol=lf

# Binary — never normalise.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.pfx       binary
*.snk       binary
