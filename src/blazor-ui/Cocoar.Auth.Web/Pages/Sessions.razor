@page "/sessions"
@inject AuthService AuthService
@inject MessageService Message
@inject ModalService Modal
@attribute [Authorize]

<PageTitle>Active Sessions - Cocoar Auth</PageTitle>

<PageContainer Title="Active Sessions">
    <Extra>
        <Popconfirm Title="Are you sure you want to log out from all other devices?"
                    OnConfirm="HandleRevokeAllSessions"
                    OkText="@("Yes, Log Out All")"
                    CancelText="Cancel">
            <Button Danger Loading="_revokingAll">
                <Icon Type="logout" Theme="IconThemeType.Outline" />
                Log Out All Other Devices
            </Button>
        </Popconfirm>
    </Extra>
    <ChildContent>
        <Card>
            <Spin Spinning="_loading">
                @if (_sessions == null || _sessions.Count == 0)
                {
                    @if (!_loading)
                    {
                        <Empty Description="@("No active sessions found")" />
                    }
                }
                else
                {
                    <Table TItem="SessionDto"
                           DataSource="_sessions"
                           Responsive
                           Size="@TableSize.Middle">
                        <PropertyColumn Property="c => c.Browser" Title="Device">
                            <Space>
                                <SpaceItem>
                                    <Icon Type="@GetDeviceIcon(context)" Theme="IconThemeType.Outline" Style="font-size: 20px;" />
                                </SpaceItem>
                                <SpaceItem>
                                    <div>
                                        <Text Strong>@context.Browser @context.BrowserVersion</Text>
                                        <br />
                                        <Text Type="@TextElementType.Secondary">@context.OperatingSystem @context.OsVersion</Text>
                                    </div>
                                </SpaceItem>
                            </Space>
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.IpAddress" Title="IP Address">
                            <Text Code>@(context.IpAddress ?? "Unknown")</Text>
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.CreatedAt" Title="Signed In">
                            <Tooltip Title="@context.CreatedAt.ToString("f")">
                                @FormatRelativeTime(context.CreatedAt)
                            </Tooltip>
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.LastActiveAt" Title="Last Active">
                            <Tooltip Title="@context.LastActiveAt.ToString("f")">
                                @FormatRelativeTime(context.LastActiveAt)
                            </Tooltip>
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.IsCurrent" Title="Status">
                            @if (context.IsCurrent)
                            {
                                <Tag Color="@PresetColor.Green.ToString()">
                                    <Icon Type="check-circle" Theme="IconThemeType.Outline" />
                                    Current Session
                                </Tag>
                            }
                            else
                            {
                                <Tag>Active</Tag>
                            }
                        </PropertyColumn>
                        <ActionColumn Title="Actions">
                            @if (!context.IsCurrent)
                            {
                                <Popconfirm Title="Are you sure you want to revoke this session?"
                                            OnConfirm="@(() => HandleRevokeSession(context))"
                                            OkText="Yes"
                                            CancelText="No">
                                    <Button Type="@ButtonType.Text" Danger Size="@ButtonSize.Small">
                                        <Icon Type="logout" Theme="IconThemeType.Outline" />
                                        Revoke
                                    </Button>
                                </Popconfirm>
                            }
                            else
                            {
                                <span style="color: #999;">-</span>
                            }
                        </ActionColumn>
                    </Table>
                }
            </Spin>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<SessionDto> _sessions = new();
    private bool _loading = true;
    private bool _revokingAll;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        _loading = true;
        try
        {
            var response = await AuthService.GetSessionsAsync();
            _sessions = response?.Sessions ?? [];
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to load sessions: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleRevokeSession(SessionDto session)
    {
        try
        {
            var result = await AuthService.RevokeSessionAsync(session.Id);
            if (result)
            {
                Message.Success("Session has been revoked.");
                await LoadSessions();
            }
            else
            {
                Message.Error("Failed to revoke session.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to revoke session: {ex.Message}");
        }
    }

    private async Task HandleRevokeAllSessions()
    {
        _revokingAll = true;
        try
        {
            var result = await AuthService.RevokeAllSessionsAsync();
            if (result)
            {
                Message.Success("All other sessions have been revoked.");
                await LoadSessions();
            }
            else
            {
                Message.Error("Failed to revoke sessions.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to revoke sessions: {ex.Message}");
        }
        finally
        {
            _revokingAll = false;
        }
    }

    private static string GetDeviceIcon(SessionDto session)
    {
        return session.DeviceType?.ToLowerInvariant() switch
        {
            "mobile" => "mobile",
            "tablet" => "tablet",
            "desktop" => "desktop",
            _ => "laptop"
        };
    }

    private static string FormatRelativeTime(DateTimeOffset time)
    {
        var diff = DateTimeOffset.UtcNow - time;

        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} minutes ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} hours ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays} days ago";

        return time.ToString("MMM d, yyyy");
    }
}
