@page "/register"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject MessageService Message

<PageTitle>Register - Cocoar Auth</PageTitle>

<div style="max-width: 450px; margin: 50px auto;">
    <Card Title="Create Account" Style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <Form Model="_model"
              OnFinish="HandleRegister"
              Layout="@FormLayout.Vertical">
            
            <FormItem Label="Username">
                <Input @bind-Value="@context.UserName" 
                       Placeholder="Choose a username"
                       Size="@InputSize.Large" />
            </FormItem>
            
            <FormItem Label="Email">
                <Input @bind-Value="@context.Email"
                       Placeholder="Enter your email"
                       Size="@InputSize.Large" />
            </FormItem>
            
            <FormItem Label="First Name">
                <Input @bind-Value="@context.FirstName" 
                       Placeholder="Enter your first name"
                       Size="@InputSize.Large" />
            </FormItem>
            
            <FormItem Label="Last Name">
                <Input @bind-Value="@context.LastName" 
                       Placeholder="Enter your last name"
                       Size="@InputSize.Large" />
            </FormItem>
            
            <FormItem Label="Password">
                <InputPassword @bind-Value="@context.Password" 
                               Placeholder="Create a password"
                               Size="@InputSize.Large" />
            </FormItem>
            
            <FormItem Label="Confirm Password">
                <InputPassword @bind-Value="@context.ConfirmPassword" 
                               Placeholder="Confirm your password"
                               Size="@InputSize.Large" />
            </FormItem>
            
            <FormItem>
                <Button Type="@ButtonType.Primary" 
                        HtmlType="submit" 
                        Loading="_loading"
                        Block
                        Size="@ButtonSize.Large">
                    Create Account
                </Button>
            </FormItem>
        </Form>
        
        <Divider Plain>Or</Divider>
        
        <div style="text-align: center;">
            <a @onclick="@(() => Navigation.NavigateTo("/login"))">
                Already have an account? Login
            </a>
        </div>
    </Card>
</div>

@code {
    private RegisterModel _model = new();
    private bool _loading;

    private class RegisterModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private async Task HandleRegister()
    {
        if (_model.Password != _model.ConfirmPassword)
        {
            Message.Error("Passwords do not match.");
            return;
        }

        _loading = true;
        try
        {
            var request = new RegisterRequest(
                _model.UserName,
                _model.Email,
                _model.FirstName,
                _model.LastName,
                _model.Password
            );

            var result = await AuthService.RegisterAsync(request);

            if (result != null)
            {
                Message.Success("Registration successful! Please login.");
                Navigation.NavigateTo("/login");
            }
            else
            {
                Message.Error("Registration failed. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Registration failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
