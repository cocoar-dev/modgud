@page "/forgot-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject MessageService Message

<PageTitle>Forgot Password - Cocoar Auth</PageTitle>

<div style="max-width: 400px; margin: 50px auto;">
    <Card Title="Forgot Password" Style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        @if (!_submitted)
        {
            <Paragraph>
                Enter your email address and we'll send you a link to reset your password.
            </Paragraph>
            
            <Form Model="_model"
                  OnFinish="HandleSubmit"
                  Layout="@FormLayout.Vertical">
                
                <FormItem Label="Email">
                    <Input @bind-Value="@context.Email"
                           Placeholder="Enter your email"
                           Size="@InputSize.Large" />
                </FormItem>
                
                <FormItem>
                    <Button Type="@ButtonType.Primary" 
                            HtmlType="submit" 
                            Loading="_loading"
                            Block
                            Size="@ButtonSize.Large">
                        Send Reset Link
                    </Button>
                </FormItem>
            </Form>
        }
        else
        {
            <Result Status="@ResultStatus.Success"
                    Title="Check Your Email"
                    SubTitle="If an account exists with that email, you will receive a password reset link.">
                <Extra>
                    <Button Type="@ButtonType.Primary" 
                            OnClick="@(() => Navigation.NavigateTo("/login"))">
                        Back to Login
                    </Button>
                </Extra>
            </Result>
        }
        
        @if (!_submitted)
        {
            <Divider Plain>Or</Divider>
            
            <div style="text-align: center;">
                <Space Direction="SpaceDirection.Vertical">
                    <SpaceItem>
                        <a @onclick="@(() => Navigation.NavigateTo("/login"))">
                            Back to Login
                        </a>
                    </SpaceItem>
                    <SpaceItem>
                        <a @onclick="@(() => Navigation.NavigateTo("/register"))">
                            Create an Account
                        </a>
                    </SpaceItem>
                </Space>
            </div>
        }
    </Card>
</div>

@code {
    private ForgotPasswordModel _model = new();
    private bool _loading;
    private bool _submitted;

    private class ForgotPasswordModel
    {
        public string Email { get; set; } = string.Empty;
    }

    private async Task HandleSubmit()
    {
        _loading = true;
        try
        {
            var request = new ForgotPasswordRequest(_model.Email);
            await AuthService.ForgotPasswordAsync(request);
            _submitted = true;
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to send reset link: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
