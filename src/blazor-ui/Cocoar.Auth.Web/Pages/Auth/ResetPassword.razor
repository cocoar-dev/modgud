@page "/reset-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject MessageService Message

<PageTitle>Reset Password - Cocoar Auth</PageTitle>

<div style="max-width: 400px; margin: 50px auto;">
    <Card Title="Reset Password" Style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        @if (!_success)
        {
            <Form Model="_model"
                  OnFinish="HandleReset"
                  Layout="@FormLayout.Vertical">
                
                <FormItem Label="Email">
                    <Input @bind-Value="@context.Email"
                           Placeholder="Enter your email"
                           Size="@InputSize.Large" />
                </FormItem>
                
                <FormItem Label="Reset Token">
                    <Input @bind-Value="@context.Token" 
                           Placeholder="Enter the token from your email"
                           Size="@InputSize.Large" />
                </FormItem>
                
                <FormItem Label="New Password">
                    <InputPassword @bind-Value="@context.NewPassword" 
                                   Placeholder="Enter your new password"
                                   Size="@InputSize.Large" />
                </FormItem>
                
                <FormItem Label="Confirm Password">
                    <InputPassword @bind-Value="@context.ConfirmPassword" 
                                   Placeholder="Confirm your new password"
                                   Size="@InputSize.Large" />
                </FormItem>
                
                <FormItem>
                    <Button Type="@ButtonType.Primary" 
                            HtmlType="submit" 
                            Loading="_loading"
                            Block
                            Size="@ButtonSize.Large">
                        Reset Password
                    </Button>
                </FormItem>
            </Form>
            
            <Divider Plain>Or</Divider>
            
            <div style="text-align: center;">
                <a @onclick="@(() => Navigation.NavigateTo("/login"))">
                    Back to Login
                </a>
            </div>
        }
        else
        {
            <Result Status="@ResultStatus.Success"
                    Title="Password Reset Successfully"
                    SubTitle="Your password has been changed. You can now login with your new password.">
                <Extra>
                    <Button Type="@ButtonType.Primary" 
                            OnClick="@(() => Navigation.NavigateTo("/login"))">
                        Go to Login
                    </Button>
                </Extra>
            </Result>
        }
    </Card>
</div>

@code {
    private ResetPasswordModel _model = new();
    private bool _loading;
    private bool _success;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
            _model.Token = Token;
        if (!string.IsNullOrEmpty(Email))
            _model.Email = Email;
    }

    private class ResetPasswordModel
    {
        public string Email { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private async Task HandleReset()
    {
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            Message.Error("Passwords do not match.");
            return;
        }

        _loading = true;
        try
        {
            var request = new ResetPasswordRequest(_model.Email, _model.Token, _model.NewPassword);
            var result = await AuthService.ResetPasswordAsync(request);

            if (result)
            {
                _success = true;
            }
            else
            {
                Message.Error("Password reset failed. The token may be invalid or expired.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Password reset failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
