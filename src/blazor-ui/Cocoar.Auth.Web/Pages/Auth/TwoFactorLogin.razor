@page "/login/2fa"
@inject AuthStateProvider AuthState
@inject NavigationManager Navigation
@inject MessageService Message

<PageTitle>Two-Factor Authentication - Cocoar Auth</PageTitle>

<div style="max-width: 400px; margin: 50px auto;">
    <Card Title="Two-Factor Authentication" Style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        @if (!AuthState.RequiresTwoFactor)
        {
            <Result Status="@ResultStatus.Warning"
                    Title="Session Expired"
                    SubTitle="Please login again to continue.">
                <Extra>
                    <Button Type="@ButtonType.Primary" OnClick="@(() => Navigation.NavigateTo("/login"))">
                        Go to Login
                    </Button>
                </Extra>
            </Result>
        }
        else
        {
            <Alert Type="@AlertType.Info"
                   Message="Verification Required"
                   Description="Please enter the 6-digit code from your authenticator app."
                   ShowIcon="true"
                   Style="margin-bottom: 24px;" />

            <Form Model="_model"
                  OnFinish="HandleTwoFactorLogin"
                  Layout="@FormLayout.Vertical">

                <FormItem Label="Verification Code">
                    <Input @bind-Value="@context.Code"
                           Placeholder="Enter 6-digit code"
                           MaxLength="6"
                           Size="@InputSize.Large"
                           Style="text-align: center; letter-spacing: 8px; font-size: 24px;" />
                </FormItem>

                <FormItem>
                    <Checkbox @bind-Value="@context.RememberMachine">Remember this device</Checkbox>
                </FormItem>

                <FormItem>
                    <Button Type="@ButtonType.Primary"
                            HtmlType="submit"
                            Loading="_loading"
                            Block
                            Size="@ButtonSize.Large">
                        Verify
                    </Button>
                </FormItem>
            </Form>

            <Divider Plain>Or</Divider>

            <div style="text-align: center;">
                <Space Direction="SpaceDirection.Vertical">
                    <SpaceItem>
                        <a @onclick="GoToRecoveryCode" style="cursor: pointer;">
                            Use a recovery code instead
                        </a>
                    </SpaceItem>
                    <SpaceItem>
                        <a @onclick="CancelAndGoBack" style="cursor: pointer;">
                            Cancel and return to login
                        </a>
                    </SpaceItem>
                </Space>
            </div>
        }
    </Card>
</div>

@code {
    private TwoFactorModel _model = new();
    private bool _loading;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private class TwoFactorModel
    {
        public string Code { get; set; } = string.Empty;
        public bool RememberMachine { get; set; }
    }

    private async Task HandleTwoFactorLogin()
    {
        if (string.IsNullOrWhiteSpace(_model.Code) || _model.Code.Length != 6)
        {
            Message.Error("Please enter a valid 6-digit code.");
            return;
        }

        _loading = true;
        try
        {
            var result = await AuthState.TwoFactorLoginAsync(_model.Code, _model.RememberMachine);

            if (result.Succeeded)
            {
                Message.Success("Login successful!");
                var redirectUrl = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
                Navigation.NavigateTo(redirectUrl);
            }
            else
            {
                Message.Error(result.Error ?? "Invalid verification code. Please try again.");
                _model.Code = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Verification failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoToRecoveryCode()
    {
        var returnParam = string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        Navigation.NavigateTo($"/login/recovery{returnParam}");
    }

    private void CancelAndGoBack()
    {
        AuthState.ClearTwoFactorState();
        Navigation.NavigateTo("/login");
    }
}
