@page "/admin/users/create"
@page "/admin/users/{UserId:guid}"
@inject UserService UserService
@inject RoleService RoleService
@inject NavigationManager Navigation
@inject MessageService Message
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@(_isEditMode ? "Edit User" : "Create User") - Cocoar Auth</PageTitle>

<PageContainer Title="@(_isEditMode ? "Edit User" : "Create User")">
    <Breadcrumb>
        <BreadcrumbItem Href="/">Home</BreadcrumbItem>
        <BreadcrumbItem Href="/admin/users">Users</BreadcrumbItem>
        <BreadcrumbItem>@(_isEditMode ? "Edit" : "Create")</BreadcrumbItem>
    </Breadcrumb>
    <ChildContent>
        <Spin Spinning="_loading">
            <Card Style="max-width: 800px;">
                <Form Model="_model"
                      OnFinish="HandleSubmit"
                      Layout="@FormLayout.Vertical">
                    
                    <Row Gutter="16">
                        <AntDesign.Col Span="12">
                            <FormItem Label="Username">
                                <Input @bind-Value="@context.UserName" 
                                       Disabled="_isEditMode"
                                       Size="@InputSize.Large" />
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <FormItem Label="Email">
                                <Input @bind-Value="@context.Email"
                                       Size="@InputSize.Large" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>
                    
                    <Row Gutter="16">
                        <AntDesign.Col Span="12">
                            <FormItem Label="First Name">
                                <Input @bind-Value="@context.FirstName" 
                                       Size="@InputSize.Large" />
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <FormItem Label="Last Name">
                                <Input @bind-Value="@context.LastName" 
                                       Size="@InputSize.Large" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>
                    
                    @if (!_isEditMode)
                    {
                        <Row Gutter="16">
                            <AntDesign.Col Span="12">
                                <FormItem Label="Password">
                                    <InputPassword @bind-Value="@context.Password" 
                                                   Size="@InputSize.Large" />
                                </FormItem>
                            </AntDesign.Col>
                            <AntDesign.Col Span="12">
                                <FormItem Label="Confirm Password">
                                    <InputPassword @bind-Value="@context.ConfirmPassword" 
                                                   Size="@InputSize.Large" />
                                </FormItem>
                            </AntDesign.Col>
                        </Row>
                    }
                    
                    <FormItem Label="Roles">
                        <Select @bind-Values="_selectedRoles"
                                TItem="string"
                                TItemValue="string"
                                DataSource="_availableRoleNames"
                                Placeholder="Select roles"
                                Style="width: 100%;" />
                    </FormItem>
                    
                    @if (_isEditMode)
                    {
                        <FormItem Label="Email Confirmed">
                            <Switch @bind-Checked="@context.EmailConfirmed" />
                        </FormItem>
                    }
                    
                    <FormItem>
                        <Space>
                            <SpaceItem>
                                <Button Type="@ButtonType.Primary" 
                                        HtmlType="submit" 
                                        Loading="_saving">
                                    @(_isEditMode ? "Update" : "Create")
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button OnClick="@(() => Navigation.NavigateTo("/admin/users"))">
                                    Cancel
                                </Button>
                            </SpaceItem>
                        </Space>
                    </FormItem>
                </Form>
            </Card>
            
            @if (_isEditMode)
            {
                <Card Title="Change Password" Style="max-width: 800px; margin-top: 16px;">
                    <Form Model="_passwordModel"
                          OnFinish="HandleChangePassword"
                          Layout="@FormLayout.Vertical">
                        
                        <Row Gutter="16">
                            <AntDesign.Col Span="12">
                                <FormItem Label="New Password">
                                    <InputPassword @bind-Value="@context.NewPassword" 
                                                   Size="@InputSize.Large" />
                                </FormItem>
                            </AntDesign.Col>
                            <AntDesign.Col Span="12">
                                <FormItem Label="Confirm Password">
                                    <InputPassword @bind-Value="@context.ConfirmPassword" 
                                                   Size="@InputSize.Large" />
                                </FormItem>
                            </AntDesign.Col>
                        </Row>
                        
                        <FormItem>
                            <Button Type="@ButtonType.Primary" 
                                    HtmlType="submit" 
                                    Loading="_changingPassword">
                                Change Password
                            </Button>
                        </FormItem>
                    </Form>
                </Card>
                
                <Card Title="User Claims" Style="max-width: 800px; margin-top: 16px;">
                    <Space Style="margin-bottom: 16px;">
                        <SpaceItem>
                            <Button Type="@ButtonType.Primary" OnClick="ShowAddClaimModal">
                                <Icon Type="plus" Theme="IconThemeType.Outline" />
                                Add Claim
                            </Button>
                        </SpaceItem>
                    </Space>

                    <Table TItem="ClaimDto"
                           DataSource="_claims"
                           Responsive
                           Size="@TableSize.Small">
                        <PropertyColumn Property="c => c.Type" Title="Type" />
                        <PropertyColumn Property="c => c.Value" Title="Value" />
                        <ActionColumn Title="Actions">
                            <Popconfirm Title="Are you sure you want to remove this claim?"
                                        OnConfirm="@(() => HandleRemoveClaim(context))"
                                        OkText="Yes"
                                        CancelText="No">
                                <Button Type="@ButtonType.Text" Danger Size="@ButtonSize.Small">
                                    <Icon Type="delete" Theme="IconThemeType.Outline" />
                                </Button>
                            </Popconfirm>
                        </ActionColumn>
                    </Table>
                </Card>

                <Card Title="Active Sessions" Style="max-width: 800px; margin-top: 16px;">
                    <Spin Spinning="_loadingSessions">
                        @if (_sessions.Count == 0 && !_loadingSessions)
                        {
                            <Empty Description="@("No active sessions")" />
                        }
                        else
                        {
                            <Space Style="margin-bottom: 16px;">
                                <SpaceItem>
                                    <Popconfirm Title="Force logout this user from all devices?"
                                                OnConfirm="HandleForceLogoutAll"
                                                OkText="@("Yes, Force Logout")"
                                                CancelText="Cancel">
                                        <Button Danger Loading="_forcingLogout">
                                            <Icon Type="logout" Theme="IconThemeType.Outline" />
                                            Force Logout All
                                        </Button>
                                    </Popconfirm>
                                </SpaceItem>
                            </Space>

                            <Table TItem="SessionDto"
                                   DataSource="_sessions"
                                   Responsive
                                   Size="@TableSize.Small">
                                <PropertyColumn Property="c => c.Browser" Title="Device">
                                    @context.Browser @context.BrowserVersion on @context.OperatingSystem
                                </PropertyColumn>
                                <PropertyColumn Property="c => c.IpAddress" Title="IP Address">
                                    <Text Code>@(context.IpAddress ?? "Unknown")</Text>
                                </PropertyColumn>
                                <PropertyColumn Property="c => c.LastActiveAt" Title="Last Active">
                                    @context.LastActiveAt.ToString("g")
                                </PropertyColumn>
                            </Table>
                        }
                    </Spin>
                </Card>

                <Card Title="Danger Zone" Style="max-width: 800px; margin-top: 16px; border-color: #ff4d4f;">
                    @if (_userDto?.IsDataMasked == true)
                    {
                        <Alert Type="@AlertType.Info"
                               Message="User Data Erased"
                               Description="This user's data has been permanently erased per GDPR request. No further actions are available."
                               ShowIcon="true" />
                    }
                    else if (_userDto?.IsDeleted == true)
                    {
                        <Alert Type="@AlertType.Warning"
                               Message="User Soft Deleted"
                               Description="This user has been soft deleted. You can restore them or permanently erase their data."
                               ShowIcon="true"
                               Style="margin-bottom: 16px;" />

                        <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                            <SpaceItem>
                                <Button Type="@ButtonType.Primary"
                                        OnClick="ShowRestoreModal"
                                        Block>
                                    <Icon Type="undo" Theme="IconThemeType.Outline" />
                                    Restore User
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button Danger
                                        OnClick="ShowPermanentEraseModal"
                                        Block>
                                    <Icon Type="delete" Theme="IconThemeType.Outline" />
                                    Permanently Erase (GDPR)
                                </Button>
                            </SpaceItem>
                        </Space>
                    }
                    else
                    {
                        <Alert Type="@AlertType.Error"
                               Message="Caution"
                               Description="Actions in this section are destructive and may not be reversible."
                               ShowIcon="true"
                               Style="margin-bottom: 16px;" />

                        <Button Danger OnClick="ShowSoftDeleteModal" Block>
                            <Icon Type="delete" Theme="IconThemeType.Outline" />
                            Soft Delete User
                        </Button>
                    }
                </Card>
            }
        </Spin>
    </ChildContent>
</PageContainer>

<Modal Title="Add Claim"
       Visible="_showClaimModal"
       OnOk="HandleAddClaim"
       OnCancel="@(() => _showClaimModal = false)"
       ConfirmLoading="_addingClaim">
    <Form Model="_claimModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Claim Type">
            <Input @bind-Value="@context.Type" />
        </FormItem>
        <FormItem Label="Claim Value">
            <Input @bind-Value="@context.Value" />
        </FormItem>
    </Form>
</Modal>

@* Soft Delete Modal *@
<Modal Title="Soft Delete User"
       Visible="_showSoftDeleteModal"
       OnOk="HandleSoftDelete"
       OnCancel="@(() => _showSoftDeleteModal = false)"
       ConfirmLoading="_softDeleting"
       OkText="@("Soft Delete")"
       OkButtonProps="@(new ButtonProps { Danger = true })">
    <Alert Type="@AlertType.Warning"
           Message="Soft Delete"
           Description="The user will be marked as deleted but their data will be retained. They can be restored later."
           ShowIcon="true"
           Style="margin-bottom: 16px;" />

    <Form Model="_gdprReasonModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Reason (optional)">
            <TextArea @bind-Value="@context.Reason"
                      Placeholder="Reason for deletion..."
                      Rows="3" />
        </FormItem>
    </Form>
</Modal>

@* Restore Modal *@
<Modal Title="Restore User"
       Visible="_showRestoreModal"
       OnOk="HandleRestore"
       OnCancel="@(() => _showRestoreModal = false)"
       ConfirmLoading="_restoring"
       OkText="@("Restore")">
    <Alert Type="@AlertType.Info"
           Message="Restore User"
           Description="The user will be restored and can access their account again."
           ShowIcon="true"
           Style="margin-bottom: 16px;" />

    <Form Model="_gdprReasonModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Reason (optional)">
            <TextArea @bind-Value="@context.Reason"
                      Placeholder="Reason for restoration..."
                      Rows="3" />
        </FormItem>
    </Form>
</Modal>

@* Permanent Erase Modal *@
<Modal Title="Permanently Erase User Data (GDPR)"
       Visible="_showPermanentEraseModal"
       OnOk="HandlePermanentErase"
       OnCancel="@(() => _showPermanentEraseModal = false)"
       ConfirmLoading="_permanentlyErasing"
       OkText="@("Permanently Erase")"
       OkButtonProps="@(new ButtonProps { Danger = true })">
    <Alert Type="@AlertType.Error"
           Message="WARNING: This action is irreversible!"
           Description="All user data will be permanently erased per GDPR Article 17 (Right to Erasure). This includes masking all personal information in the event store."
           ShowIcon="true"
           Style="margin-bottom: 16px;" />

    <Form Model="_gdprReasonModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Reason (required)">
            <TextArea @bind-Value="@context.Reason"
                      Placeholder="GDPR erasure request, legal requirement, etc."
                      Rows="3" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter]
    public Guid? UserId { get; set; }

    private bool _isEditMode => UserId.HasValue;
    private UserFormModel _model = new();
    private PasswordModel _passwordModel = new();
    private ClaimFormModel _claimModel = new();
    private List<RoleDto> _availableRoles = new();
    private IEnumerable<string> _availableRoleNames => _availableRoles.Select(r => r.Name);
    private IEnumerable<string> _selectedRoles = Enumerable.Empty<string>();
    private List<ClaimDto> _claims = new();
    private bool _loading = true;
    private bool _saving;
    private bool _changingPassword;
    private bool _showClaimModal;
    private bool _addingClaim;

    // User DTO for status checks
    private UserDto? _userDto;

    // Sessions
    private List<SessionDto> _sessions = new();
    private bool _loadingSessions;
    private bool _forcingLogout;

    // GDPR modals
    private bool _showSoftDeleteModal;
    private bool _showRestoreModal;
    private bool _showPermanentEraseModal;
    private GdprReasonModel _gdprReasonModel = new();
    private bool _softDeleting;
    private bool _restoring;
    private bool _permanentlyErasing;

    private class UserFormModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public bool EmailConfirmed { get; set; }
    }

    private class PasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private class ClaimFormModel
    {
        public string Type { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private class GdprReasonModel
    {
        public string? Reason { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();

        if (_isEditMode)
        {
            await LoadUser();
            await LoadSessions();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            _availableRoles = await RoleService.GetRolesAsync();
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to load roles: {ex.Message}");
        }
    }

    private async Task LoadUser()
    {
        _loading = true;
        try
        {
            var user = await UserService.GetUserAsync(UserId!.Value);
            if (user != null)
            {
                _userDto = user;
                _model = new UserFormModel
                {
                    UserName = user.UserName,
                    Email = user.Email,
                    FirstName = user.FirstName,
                    LastName = user.LastName,
                    EmailConfirmed = user.EmailConfirmed
                };
                _selectedRoles = user.Roles;
                _claims = user.Claims.ToList();
            }
            else
            {
                Message.Error("User not found.");
                Navigation.NavigateTo("/admin/users");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to load user: {ex.Message}");
            Navigation.NavigateTo("/admin/users");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSessions()
    {
        _loadingSessions = true;
        try
        {
            var response = await UserService.GetUserSessionsAsync(UserId!.Value);
            _sessions = response?.Sessions ?? [];
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to load sessions: {ex.Message}");
        }
        finally
        {
            _loadingSessions = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (!_isEditMode && _model.Password != _model.ConfirmPassword)
        {
            Message.Error("Passwords do not match.");
            return;
        }

        _saving = true;
        try
        {
            if (_isEditMode)
            {
                var request = new UpdateUserRequest(
                    _model.Email,
                    _model.FirstName,
                    _model.LastName,
                    _model.EmailConfirmed,
                    _selectedRoles.ToList()
                );

                var result = await UserService.UpdateUserAsync(UserId!.Value, request);
                if (result != null)
                {
                    Message.Success("User updated successfully!");
                }
                else
                {
                    Message.Error("Failed to update user.");
                }
            }
            else
            {
                var request = new CreateUserRequest(
                    _model.UserName,
                    _model.Email,
                    _model.FirstName,
                    _model.LastName,
                    _model.Password,
                    _selectedRoles.ToList()
                );

                var result = await UserService.CreateUserAsync(request);
                if (result != null)
                {
                    Message.Success("User created successfully!");
                    Navigation.NavigateTo("/admin/users");
                }
                else
                {
                    Message.Error("Failed to create user.");
                }
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Operation failed: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleChangePassword()
    {
        if (_passwordModel.NewPassword != _passwordModel.ConfirmPassword)
        {
            Message.Error("Passwords do not match.");
            return;
        }

        _changingPassword = true;
        try
        {
            var result = await UserService.ResetUserPasswordAsync(UserId!.Value, _passwordModel.NewPassword);
            if (result)
            {
                Message.Success("Password changed successfully!");
                _passwordModel = new PasswordModel();
            }
            else
            {
                Message.Error("Failed to change password.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to change password: {ex.Message}");
        }
        finally
        {
            _changingPassword = false;
        }
    }

    private void ShowAddClaimModal()
    {
        _claimModel = new ClaimFormModel();
        _showClaimModal = true;
    }

    private async Task HandleAddClaim()
    {
        if (string.IsNullOrWhiteSpace(_claimModel.Type) || string.IsNullOrWhiteSpace(_claimModel.Value))
        {
            Message.Error("Claim type and value are required.");
            return;
        }

        _addingClaim = true;
        try
        {
            var request = new AddClaimRequest(_claimModel.Type, _claimModel.Value);
            var result = await UserService.AddClaimAsync(UserId!.Value, request);
            if (result)
            {
                Message.Success("Claim added successfully!");
                _showClaimModal = false;
                await LoadUser();
            }
            else
            {
                Message.Error("Failed to add claim.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to add claim: {ex.Message}");
        }
        finally
        {
            _addingClaim = false;
        }
    }

    private async Task HandleRemoveClaim(ClaimDto claim)
    {
        try
        {
            var result = await UserService.RemoveClaimAsync(UserId!.Value, claim.Type, claim.Value);
            if (result)
            {
                Message.Success("Claim removed successfully!");
                await LoadUser();
            }
            else
            {
                Message.Error("Failed to remove claim.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to remove claim: {ex.Message}");
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // SESSION MANAGEMENT
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task HandleForceLogoutAll()
    {
        _forcingLogout = true;
        try
        {
            var result = await UserService.RevokeAllUserSessionsAsync(UserId!.Value);
            if (result)
            {
                Message.Success("User has been logged out from all devices.");
                await LoadSessions();
            }
            else
            {
                Message.Error("Failed to force logout.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to force logout: {ex.Message}");
        }
        finally
        {
            _forcingLogout = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // GDPR ACTIONS
    // ═══════════════════════════════════════════════════════════════════════════

    private void ShowSoftDeleteModal()
    {
        _gdprReasonModel = new GdprReasonModel();
        _showSoftDeleteModal = true;
    }

    private void ShowRestoreModal()
    {
        _gdprReasonModel = new GdprReasonModel();
        _showRestoreModal = true;
    }

    private void ShowPermanentEraseModal()
    {
        _gdprReasonModel = new GdprReasonModel();
        _showPermanentEraseModal = true;
    }

    private async Task HandleSoftDelete()
    {
        _softDeleting = true;
        try
        {
            var result = await UserService.SoftDeleteUserAsync(UserId!.Value, _gdprReasonModel.Reason);
            if (result)
            {
                Message.Success("User has been soft deleted.");
                _showSoftDeleteModal = false;
                await LoadUser();
            }
            else
            {
                Message.Error("Failed to soft delete user.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to soft delete user: {ex.Message}");
        }
        finally
        {
            _softDeleting = false;
        }
    }

    private async Task HandleRestore()
    {
        _restoring = true;
        try
        {
            var result = await UserService.RestoreUserAsync(UserId!.Value, _gdprReasonModel.Reason);
            if (result)
            {
                Message.Success("User has been restored.");
                _showRestoreModal = false;
                await LoadUser();
            }
            else
            {
                Message.Error("Failed to restore user.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to restore user: {ex.Message}");
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task HandlePermanentErase()
    {
        if (string.IsNullOrWhiteSpace(_gdprReasonModel.Reason))
        {
            Message.Error("A reason is required for permanent erasure.");
            return;
        }

        _permanentlyErasing = true;
        try
        {
            var result = await UserService.PermanentlyEraseUserAsync(UserId!.Value, _gdprReasonModel.Reason!);
            if (result)
            {
                Message.Success("User data has been permanently erased per GDPR request.");
                _showPermanentEraseModal = false;
                await LoadUser();
            }
            else
            {
                Message.Error("Failed to permanently erase user data.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to permanently erase user data: {ex.Message}");
        }
        finally
        {
            _permanentlyErasing = false;
        }
    }
}
