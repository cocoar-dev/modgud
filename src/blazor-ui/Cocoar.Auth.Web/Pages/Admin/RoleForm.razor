@page "/admin/roles/create"
@page "/admin/roles/{RoleId:guid}"
@inject RoleService RoleService
@inject NavigationManager Navigation
@inject MessageService Message
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@(_isEditMode ? "Edit Role" : "Create Role") - Cocoar Auth</PageTitle>

<PageContainer Title="@(_isEditMode ? "Edit Role" : "Create Role")">
    <Breadcrumb>
        <BreadcrumbItem Href="/">Home</BreadcrumbItem>
        <BreadcrumbItem Href="/admin/roles">Roles</BreadcrumbItem>
        <BreadcrumbItem>@(_isEditMode ? "Edit" : "Create")</BreadcrumbItem>
    </Breadcrumb>
    <ChildContent>
        <Spin Spinning="_loading">
            <Card Style="max-width: 600px;">
                <Form Model="_model"
                      OnFinish="HandleSubmit"
                      Layout="@FormLayout.Vertical">
                    
                    <FormItem Label="Role Name">
                        <Input @bind-Value="@context.Name" 
                               Disabled="_isEditMode"
                               Placeholder="Enter role name"
                               Size="@InputSize.Large" />
                    </FormItem>
                    
                    <FormItem Label="Description">
                        <TextArea @bind-Value="@context.Description" 
                                  Placeholder="Enter role description"
                                  Rows="3" />
                    </FormItem>
                    
                    <FormItem>
                        <Space>
                            <SpaceItem>
                                <Button Type="@ButtonType.Primary" 
                                        HtmlType="submit" 
                                        Loading="_saving">
                                    @(_isEditMode ? "Update" : "Create")
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button OnClick="@(() => Navigation.NavigateTo("/admin/roles"))">
                                    Cancel
                                </Button>
                            </SpaceItem>
                        </Space>
                    </FormItem>
                </Form>
            </Card>
            
            @if (_isEditMode)
            {
                <Card Title="Role Claims" Style="max-width: 600px; margin-top: 16px;">
                    <Space Style="margin-bottom: 16px;">
                        <SpaceItem>
                            <Button Type="@ButtonType.Primary" OnClick="ShowAddClaimModal">
                                <Icon Type="plus" Theme="IconThemeType.Outline" />
                                Add Claim
                            </Button>
                        </SpaceItem>
                    </Space>
                    
                    <Table TItem="ClaimDto"
                           DataSource="_claims"
                           Responsive
                           Size="@TableSize.Small">
                        <PropertyColumn Property="c => c.Type" Title="Type" />
                        <PropertyColumn Property="c => c.Value" Title="Value" />
                        <ActionColumn Title="Actions">
                            <Popconfirm Title="Are you sure you want to remove this claim?"
                                        OnConfirm="@(() => HandleRemoveClaim(context))"
                                        OkText="Yes"
                                        CancelText="No">
                                <Button Type="@ButtonType.Text" Danger Size="@ButtonSize.Small">
                                    <Icon Type="delete" Theme="IconThemeType.Outline" />
                                </Button>
                            </Popconfirm>
                        </ActionColumn>
                    </Table>
                </Card>
            }
        </Spin>
    </ChildContent>
</PageContainer>

<Modal Title="Add Claim"
       Visible="_showClaimModal"
       OnOk="HandleAddClaim"
       OnCancel="@(() => _showClaimModal = false)"
       ConfirmLoading="_addingClaim">
    <Form Model="_claimModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Claim Type">
            <Input @bind-Value="@context.Type" Placeholder="e.g., Permission" />
        </FormItem>
        <FormItem Label="Claim Value">
            <Input @bind-Value="@context.Value" Placeholder="e.g., CanEditUsers" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter]
    public Guid? RoleId { get; set; }

    private bool _isEditMode => RoleId.HasValue;
    private RoleFormModel _model = new();
    private ClaimFormModel _claimModel = new();
    private List<ClaimDto> _claims = new();
    private bool _loading;
    private bool _saving;
    private bool _showClaimModal;
    private bool _addingClaim;

    private class RoleFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private class ClaimFormModel
    {
        public string Type { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        if (_isEditMode)
        {
            await LoadRole();
        }
    }

    private async Task LoadRole()
    {
        _loading = true;
        try
        {
            var role = await RoleService.GetRoleAsync(RoleId!.Value);
            if (role != null)
            {
                _model = new RoleFormModel
                {
                    Name = role.Name,
                    Description = role.Description ?? string.Empty
                };
                _claims = role.Claims.ToList();
            }
            else
            {
                Message.Error("Role not found.");
                Navigation.NavigateTo("/admin/roles");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to load role: {ex.Message}");
            Navigation.NavigateTo("/admin/roles");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Message.Error("Role name is required.");
            return;
        }

        _saving = true;
        try
        {
            if (_isEditMode)
            {
                var request = new UpdateRoleRequest(_model.Description);
                var result = await RoleService.UpdateRoleAsync(RoleId!.Value, request);
                if (result != null)
                {
                    Message.Success("Role updated successfully!");
                }
                else
                {
                    Message.Error("Failed to update role.");
                }
            }
            else
            {
                var request = new CreateRoleRequest(_model.Name, _model.Description);
                var result = await RoleService.CreateRoleAsync(request);
                if (result != null)
                {
                    Message.Success("Role created successfully!");
                    Navigation.NavigateTo("/admin/roles");
                }
                else
                {
                    Message.Error("Failed to create role.");
                }
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Operation failed: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowAddClaimModal()
    {
        _claimModel = new ClaimFormModel();
        _showClaimModal = true;
    }

    private async Task HandleAddClaim()
    {
        if (string.IsNullOrWhiteSpace(_claimModel.Type) || string.IsNullOrWhiteSpace(_claimModel.Value))
        {
            Message.Error("Claim type and value are required.");
            return;
        }

        _addingClaim = true;
        try
        {
            var request = new AddClaimRequest(_claimModel.Type, _claimModel.Value);
            var result = await RoleService.AddClaimAsync(RoleId!.Value, request);
            if (result)
            {
                Message.Success("Claim added successfully!");
                _showClaimModal = false;
                await LoadRole();
            }
            else
            {
                Message.Error("Failed to add claim.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to add claim: {ex.Message}");
        }
        finally
        {
            _addingClaim = false;
        }
    }

    private async Task HandleRemoveClaim(ClaimDto claim)
    {
        try
        {
            var result = await RoleService.RemoveClaimAsync(RoleId!.Value, claim.Type, claim.Value);
            if (result)
            {
                Message.Success("Claim removed successfully!");
                await LoadRole();
            }
            else
            {
                Message.Error("Failed to remove claim.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to remove claim: {ex.Message}");
        }
    }
}
