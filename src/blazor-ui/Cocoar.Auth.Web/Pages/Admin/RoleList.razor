@page "/admin/roles"
@inject RoleService RoleService
@inject NavigationManager Navigation
@inject MessageService Message
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Roles - Cocoar Auth</PageTitle>

<PageContainer Title="Role Management">
    <Extra>
        <Button Type="@ButtonType.Primary" 
                OnClick="@(() => Navigation.NavigateTo("/admin/roles/create"))">
            <Icon Type="plus" Theme="IconThemeType.Outline" />
            Create Role
        </Button>
    </Extra>
    <ChildContent>
        <Card>
            <Table TItem="RoleDto"
                   DataSource="_roles"
                   Loading="_loading"
                   Responsive>
                <PropertyColumn Property="c => c.Name" Title="Name" Sortable />
                <PropertyColumn Property="c => c.Description" Title="Description" />
                <ActionColumn Title="Actions">
                    <Space>
                        <SpaceItem>
                            <Tooltip Title="@("Edit")">
                                <Button Type="@ButtonType.Text" 
                                        OnClick="@(() => Navigation.NavigateTo($"/admin/roles/{context.Id}"))">
                                    <Icon Type="edit" Theme="IconThemeType.Outline" />
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="@("Delete")">
                                <Popconfirm Title="Are you sure you want to delete this role?"
                                            OnConfirm="@(() => HandleDelete(context))"
                                            OkText="Yes"
                                            CancelText="No">
                                    <Button Type="@ButtonType.Text" Danger>
                                        <Icon Type="delete" Theme="IconThemeType.Outline" />
                                    </Button>
                                </Popconfirm>
                            </Tooltip>
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<RoleDto> _roles = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        _loading = true;
        try
        {
            _roles = await RoleService.GetRolesAsync();
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to load roles: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleDelete(RoleDto role)
    {
        try
        {
            var result = await RoleService.DeleteRoleAsync(role.Id);
            if (result)
            {
                Message.Success($"Role '{role.Name}' has been deleted.");
                await LoadRoles();
            }
            else
            {
                Message.Error("Failed to delete role.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Failed to delete role: {ex.Message}");
        }
    }
}
