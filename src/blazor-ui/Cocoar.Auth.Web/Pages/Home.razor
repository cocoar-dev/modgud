@page "/"
@inject AuthStateProvider AuthState

<PageTitle>Cocoar Auth - Identity Server</PageTitle>

<div style="text-align: center; padding: 50px;">
    <Title Level="1">
        <Icon Type="safety-certificate" Theme="IconThemeType.Outline" Style="color: #1890ff;" />
        Cocoar Auth
    </Title>
    <Paragraph Type="@TextElementType.Secondary" Style="font-size: 18px;">
        A full-featured Identity Server built with .NET 10, Marten & Event Sourcing
    </Paragraph>
    
    <Divider />
    
    @if (AuthState.IsAuthenticated)
    {
        <Result
            Status="@ResultStatus.Success"
            Title="@($"Welcome back, {AuthState.CurrentUser?.UserName}!")"
            SubTitle="You are logged in.">
            <Extra>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => Navigation.NavigateTo("/profile"))">
                            <Icon Type="user" /> View Profile
                        </Button>
                    </SpaceItem>
                    @if (AuthState.IsAdmin)
                    {
                        <SpaceItem>
                            <Button OnClick="@(() => Navigation.NavigateTo("/admin/users"))">
                                <Icon Type="team" /> Manage Users
                            </Button>
                        </SpaceItem>
                    }
                </Space>
            </Extra>
        </Result>
    }
    else
    {
        <Result
            Status="@ResultStatus.Info"
            Title="Welcome to Cocoar Auth"
            SubTitle="Please login or register to continue.">
            <Extra>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" OnClick="@(() => Navigation.NavigateTo("/login"))">
                            <Icon Type="login" /> Login
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Size="@ButtonSize.Large" OnClick="@(() => Navigation.NavigateTo("/register"))">
                            <Icon Type="user-add" /> Register
                        </Button>
                    </SpaceItem>
                </Space>
            </Extra>
        </Result>
    }
    
    <Divider />
    
    <Row Gutter="16" Justify="RowJustify.Center">
        <Col Span="8">
            <Card Title="Event Sourcing" Bordered>
                <Icon Type="history" Style="font-size: 32px; color: #52c41a;" />
                <Paragraph>
                    Full audit trail with Marten event store
                </Paragraph>
            </Card>
        </Col>
        <Col Span="8">
            <Card Title="CQRS Pattern" Bordered>
                <Icon Type="api" Style="font-size: 32px; color: #1890ff;" />
                <Paragraph>
                    Clean separation with Wolverine
                </Paragraph>
            </Card>
        </Col>
        <Col Span="8">
            <Card Title="API First" Bordered>
                <Icon Type="cloud-server" Style="font-size: 32px; color: #722ed1;" />
                <Paragraph>
                    RESTful API for any frontend
                </Paragraph>
            </Card>
        </Col>
    </Row>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
