@inherits LayoutComponentBase
@inject AuthStateProvider AuthState
@inject NavigationManager Navigation

<AntDesign.ProLayout.BasicLayout
    Title="Cocoar Auth"
    Logo="@("favicon.png")"
    MenuData="_menuData"
    @bind-Collapsed="_collapsed">
    
    <RightContentRender>
        @if (AuthState.IsAuthenticated)
        {
            <Space>
                <SpaceItem>
                    <span>@AuthState.CurrentUser?.UserName</span>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Text" OnClick="Logout">
                        <Icon Type="logout" />
                        Logout
                    </Button>
                </SpaceItem>
            </Space>
        }
        else
        {
            <Button Type="@ButtonType.Primary" OnClick="@(() => Navigation.NavigateTo("/login"))">
                Login
            </Button>
        }
    </RightContentRender>
    
    <ChildContent>
        <div style="padding: 24px;">
            @Body
        </div>
    </ChildContent>
    
</AntDesign.ProLayout.BasicLayout>

@code {
    private bool _collapsed;
    private MenuDataItem[] _menuData = [];

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        AuthState.OnAuthStateChanged += StateHasChanged;
        UpdateMenu();
    }

    private void UpdateMenu()
    {
        var items = new List<MenuDataItem>
        {
            new MenuDataItem
            {
                Path = "/",
                Name = "Home",
                Icon = "home"
            }
        };

        if (AuthState.IsAuthenticated)
        {
            items.Add(new MenuDataItem
            {
                Path = "/profile",
                Name = "Profile",
                Icon = "user"
            });
            items.Add(new MenuDataItem
            {
                Path = "/sessions",
                Name = "Sessions",
                Icon = "laptop"
            });
            items.Add(new MenuDataItem
            {
                Path = "/privacy",
                Name = "Privacy & Data",
                Icon = "safety"
            });
        }

        if (AuthState.IsAdmin)
        {
            items.Add(new MenuDataItem
            {
                Name = "Administration",
                Icon = "setting",
                Children = new[]
                {
                    new MenuDataItem { Path = "/admin/users", Name = "Users", Icon = "team" },
                    new MenuDataItem { Path = "/admin/roles", Name = "Roles", Icon = "safety" }
                }
            });
        }

        _menuData = items.ToArray();
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        UpdateMenu();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthState.OnAuthStateChanged -= StateHasChanged;
    }
}
