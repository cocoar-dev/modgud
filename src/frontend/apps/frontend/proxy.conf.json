{
  "/*/api": {
    "target": "http://localhost",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "cookieDomainRewrite": "localhost",
    "cookiePathRewrite": "/"
  },
  "/*/connect": {
    "target": "http://localhost",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "cookieDomainRewrite": "localhost",
    "cookiePathRewrite": "/"
  },
  "/*/.well-known": {
    "target": "http://localhost",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "cookieDomainRewrite": "localhost",
    "cookiePathRewrite": "/"
  }
}
