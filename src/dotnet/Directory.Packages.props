<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Cocoar.Json.Mutable" Version="1.2.0" />
    <!-- SAST analyzer; injected by Directory.Build.props as
         analyzer-only PackageReference (PrivateAssets=all). -->
    <PackageVersion Include="SecurityCodeScan.VS2019" Version="5.6.7" />
    <PackageVersion Include="Cocoar.JsEval.Engine" Version="4.1.0" />
    <PackageVersion Include="Cocoar.JsEval.Linq" Version="4.1.0" />
    <PackageVersion Include="Cocoar.JsEval.TsDefinition" Version="4.1.0" />
    <PackageVersion Include="Cocoar.JsEval.TypeScript" Version="4.1.0" />
    <PackageVersion Include="Cocoar.Reflectensions" Version="1.0.2" />
    <PackageVersion Include="Cocoar.SignalARRR.Server" Version="5.1.0-beta.3" />
    <!-- ADR 0010 — Postgres backplane on the master DB; carries Modgud's live-update cluster subject. -->
    <PackageVersion Include="Cocoar.SignalARRR.Server.Backplane.Postgres" Version="5.1.0-beta.3" />
    <!-- Microsoft packages -->
    <PackageVersion Include="Fido2.AspNet" Version="4.0.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Postmark" Version="5.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <!-- SAML 2.0 SP federation (BSD-3-Clause, compatible with Apache-2.0).
         Maintained by FoxIDs; tested against Entra ID, ADFS, Azure AD B2C.
         See the maintainers' 'saml-federation' design note for library audit. -->
    <PackageVersion Include="ITfoxtec.Identity.Saml2" Version="4.20.1" />
    <PackageVersion Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.20.1" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive-CVE pin: Microsoft.AspNetCore.OpenApi floats Microsoft.OpenApi
         at [2.0.0, ), which resolves to the vulnerable 2.0.0
         (GHSA-v5pm-xwqc-g5wc, circular-schema-reference DoS in parsing).
         Referenced directly from Modgud.Api so the whole graph lifts to the
         patched 2.x. Drop this once AspNetCore.OpenApi requires >= 2.7.5. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Marten & Wolverine — Critter Stack 2026 (Marten 9 + Wolverine 6 +
         JasperFx 2). Migrated from 8.37 / 5.32 in chore/critter-stack-2026.
         Gotchas: the maintainers' 'critter-stack-2026' engineering note.
         9.11 was temporarily pinned after the JasperFx source-generator stopped
         dispatching the inherited, cross-assembly Principal projection reliably.
         The projection is now split by concrete document type (Person + Group),
         matching Marten's supported subclass-projection pattern and removing that
         generator edge case. 9.23 also includes the 9.13 LINQ SQL-injection fix
         and later async-daemon/catch-up hardening. Keep Marten and WolverineFx.Marten
         on the versions paired by Wolverine, and gate future lifts with the full
         integration suite plus the reset/projection stress test. -->
    <PackageVersion Include="Marten" Version="9.23.0" />
    <PackageVersion Include="Marten.AspNetCore" Version="9.23.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.27.1" />
    <!-- Marten 9.8+ bundles the JasperFx events source generator as an analyzer
         (analyzers/dotnet/cs/JasperFx.Events.SourceGenerator.dll inside the
         Marten package), so no standalone JasperFx.Events.SourceGenerator
         package is referenced anymore — adding it loaded the generator twice
         and broke the build with duplicate *.Evolver.g.cs (CS0101/CS0111). -->
    <!-- Wolverine 6 decoupled the Roslyn runtime codegen from core;
         IMessageBus.InvokeAsync<T> needs it in the host project. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.27.1" />
    <!-- Other packages -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Rx 7 collapsed the facade packages (System.Reactive.Linq / .Core / …)
         into the single System.Reactive package — no 7.x facade exists. -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="System.Linq.Async.Queryable" Version="7.0.1" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <!-- Device-info parsing for per-user session tracking -->
    <PackageVersion Include="Wangkanai.Detection" Version="8.20.0" />
    <!-- BCrypt for OAuth client/api secret hashing -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- SourceLink for published NuGet packages -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <!-- OpenIddict (custom Marten stores, no EF Core) -->
    <PackageVersion Include="OpenIddict" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Server" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation" Version="7.6.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Testcontainers 4.13 transitively resolves SSH.NET 2025.1.0, which is
         vulnerable to arbitrary writes during recursive SCP downloads
         (GHSA-q939-rpr3-3284). Keep the direct pin until Testcontainers lifts
         its minimum to the patched 2026 line. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Slice-boundary tests under Modgud.Tests.Unit/Architecture/. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Quartz.NET — AspNetCore hosting integration. Production runs the
         clustered Postgres job store in the master DB (ADR 0010); Development
         and Testing keep the in-memory store. SchedulingBootstrap re-applies
         JobConfig overrides from Marten on every boot either way. -->
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.18.2" />
    <PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="3.18.2" />
    <!-- Cocoar Configuration v6 — additive over v5 (aggregate rules, multi-tenant
         + DI-backed config); no breaking API changes for our usage. -->
    <PackageVersion Include="Cocoar.Configuration" Version="6.1.0" />
    <PackageVersion Include="Cocoar.Configuration.AspNetCore" Version="6.1.0" />
    <!-- OpenTelemetry (Audit-Followup 2026-05-13, Phase 1 foundation).
         Prometheus AspNetCore exporter stays officially beta in upstream
         OTel-dotnet but is widely used; OTLP exporter is GA. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <!-- OpenTelemetry Phase 4: Serilog → OTLP log export. The sink owns its own
         OTLP client (gRPC/HTTP), so it is independent of the OTel SDK exporter
         version line above; it is wired as a Serilog sink because the app uses
         AddSerilog (writeToProviders:false), where an OTel ILoggerProvider would
         miss the Serilog enrichers (the RealmLogEnricher tag). -->
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Health-checks: Npgsql probe for /health/ready. -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <!-- OpenTelemetry Phase 3: Postgres-query tracing via Npgsql's own ActivitySource. -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>
</Project>
