<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cocoar.Auth.Authorization</RootNamespace>
    <AssemblyName>Cocoar.Auth.Authorization</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cocoar.Auth.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulls in ASP.NET Core types (IEndpointFilter, RouteHandlerBuilder, etc.)
         from the shared framework without making this a Web-host project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure evaluator + permission-string primitives. Kept in a separate
         assembly so external RS libs (Cocoar.Auth.Client.AspNetCore and
         downstream service consumers) can reuse the same logic without
         pulling Marten/Wolverine/JsEval transitively. -->
    <ProjectReference Include="..\Cocoar.Auth.Permissions.Abstractions\Cocoar.Auth.Permissions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence + messaging — fix gesetzt für alle Konsumenten. -->
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="JasperFx.Events.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Script evaluation for access policies. -->
    <PackageReference Include="Cocoar.JsEval.Engine" />
    <PackageReference Include="Cocoar.JsEval.Linq" />
    <PackageReference Include="Cocoar.JsEval.TypeScript" />
    <PackageReference Include="Cocoar.JsEval.TsDefinition" />

    <!-- Command return-types (used by handlers). -->
    <PackageReference Include="ErrorOr" />

    <!-- Note: Microsoft.Extensions.DependencyInjection.Abstractions and
         Microsoft.Extensions.Logging.Abstractions are already provided by
         Microsoft.AspNetCore.App's shared framework — don't re-add them. -->
  </ItemGroup>

</Project>
