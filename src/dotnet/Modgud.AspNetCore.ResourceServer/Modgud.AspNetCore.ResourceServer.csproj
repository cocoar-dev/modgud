<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Modgud.AspNetCore.ResourceServer</RootNamespace>
    <Description>
      ASP.NET Core integration for Modgud resource servers. Validates
      JWT access tokens, opaque reference tokens via introspection, or both
      through one AddModgudResourceServer registration, then surfaces the per-audience
      resource_access roles/permissions as flat claims so
      [Authorize(Roles="...")] and .RequireModgudPermission("...") work
      natively. Bypass tiers are pre-expanded by the IdP, so the lib does
      pure exact-match — no evaluator logic.
    </Description>
  </PropertyGroup>

  <!-- NuGet package metadata. Version is supplied by CI via
       -p:Version=… (GitVersion output); kept out of source so the
       source-of-truth for versioning is the git tag, not a checked-in
       string. -->
  <PropertyGroup>
    <PackageId>Modgud.AspNetCore.ResourceServer</PackageId>
    <Authors>Cocoar</Authors>
    <Company>Cocoar</Company>
    <Copyright>Copyright © Cocoar</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/cocoar-dev/modgud</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cocoar-dev/modgud</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>modgud;oidc;oauth;openid-connect;authorization;resource-access;aspnetcore;identity</PackageTags>
    <!-- Build artifacts the NuGet package needs. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Pack only when explicitly requested (`dotnet pack`), not on
         every `dotnet build` — the IdP host repo builds far more often
         than it publishes. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Files packed into the nupkg next to the assembly. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- JwtBearer is not in the AspNetCore.App shared framework — needs
         its own package. The lib hooks JwtBearer.Events.OnTokenValidated
         to project resource_access onto the validated principal. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- SourceLink — embeds git metadata so debuggers can step into
         this package's source on github.com. PrivateAssets=All keeps it
         out of consumers' transitive graph. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modgud.Tests.Unit" />
    <!-- Modgud.Api.Tests boots a minimal resource-server host over this library
         and routes the named introspection HttpClient to the in-memory IdP. -->
    <InternalsVisibleTo Include="Modgud.Api.Tests" />
  </ItemGroup>

</Project>
