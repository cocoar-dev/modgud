<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- Run IDE-style analyzers (IDE0051 unused private member,
             IDE0052 unread private member, etc.) at build time so
             dead code surfaces in `dotnet build` output, not only in
             the IDE. Severities tuned in repo-root .editorconfig. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- SecurityCodeScan adds SAST coverage on top of the built-in
         NetAnalyzers — covers cookie security, ASP.NET-specific
         patterns, ReDoS variants, and other surfaces NetAnalyzers
         doesn't track. PrivateAssets=All so it doesn't leak into
         consumers of these projects as a transitive dep. Severities
         are tuned via .editorconfig (SCSnnnn rule IDs). -->
    <ItemGroup>
        <PackageReference Include="SecurityCodeScan.VS2019">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
