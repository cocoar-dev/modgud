<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Modgud.Authorization</RootNamespace>
    <AssemblyName>Modgud.Authorization</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modgud.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulls in ASP.NET Core types (IEndpointFilter, RouteHandlerBuilder, etc.)
         from the shared framework without making this a Web-host project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure evaluator + permission-string primitives. Kept in a separate
         assembly so downstream consumers that evaluate raw grants can reuse
         the logic without pulling Marten/Wolverine/JsEval transitively. The
         resource-server package receives pre-expanded concrete permissions
         and deliberately does not reference this assembly. -->
    <ProjectReference Include="..\Modgud.Permissions.Abstractions\Modgud.Permissions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence + messaging — fix gesetzt für alle Konsumenten. -->
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx.Marten" />
    <!-- No explicit JasperFx.Events.SourceGenerator ref: Marten 9.8+ bundles the
         events source generator as an analyzer, so a direct Marten reference
         already runs it. Adding the standalone package again loads the same
         generator twice -> duplicate *.Evolver.g.cs -> CS0111. (Modgud.Domain
         keeps the explicit ref because it has no direct Marten reference.) -->

    <!-- Script evaluation for access policies. -->
    <PackageReference Include="Cocoar.JsEval.Engine" />
    <PackageReference Include="Cocoar.JsEval.Linq" />
    <PackageReference Include="Cocoar.JsEval.TypeScript" />
    <PackageReference Include="Cocoar.JsEval.TsDefinition" />

    <!-- Command return-types (used by handlers). -->
    <PackageReference Include="ErrorOr" />

    <!-- Note: Microsoft.Extensions.DependencyInjection.Abstractions and
         Microsoft.Extensions.Logging.Abstractions are already provided by
         Microsoft.AspNetCore.App's shared framework — don't re-add them. -->
  </ItemGroup>

</Project>
