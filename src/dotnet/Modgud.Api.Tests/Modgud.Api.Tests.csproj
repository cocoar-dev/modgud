<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Modgud.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Generic container builder for the OTel Collector in OtelLogsRedactionTests. -->
    <PackageReference Include="Testcontainers" />
    <!-- Quartz.Extensions.Hosting is a transitive dep of Modgud.Infrastructure
         but its runtime assembly (Quartz.Extensions.DependencyInjection.dll)
         doesn't propagate to test bin output reliably (FrameworkReference
         interaction). Pull it in explicitly so AddScheduling() succeeds at
         host boot. -->
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modgud.Api\Modgud.Api.csproj" />
    <ProjectReference Include="..\Modgud.Provisioning.TestKit\Modgud.Provisioning.TestKit.csproj" />
    <!-- The resource-server client library, exercised end-to-end (reference-token
         introspection path) by UserInfoPerAudienceTests. -->
    <ProjectReference Include="..\Modgud.Client.AspNetCore\Modgud.Client.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- OtelLogsRedactionTests: the test collector config, plus the shipped one
         (linked) so the test can assert their redaction blocks match verbatim. -->
    <Content Include="Observability\otel-collector-test-config.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\docker\otel-collector\otel-collector-config.yaml" Link="Observability\otel-collector-config.shipped.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
