<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Modgud.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modgud.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cocoar.JsEval.Engine" />
    <PackageReference Include="Cocoar.JsEval.Linq" />
    <PackageReference Include="Cocoar.JsEval.TsDefinition" />
    <PackageReference Include="Cocoar.JsEval.TypeScript" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Postmark" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Marten.AspNetCore" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <!-- Marten 9.8+ bundles the JasperFx events source generator as an analyzer;
         a direct Marten ref runs it. The standalone package would double it
         (duplicate *.Evolver.g.cs -> CS0111), so it is intentionally omitted. -->
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="System.Linq.Async.Queryable" />
    <PackageReference Include="Cocoar.Reflectensions" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="OpenIddict" />
    <PackageReference Include="OpenIddict.Abstractions" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.Server" />
    <PackageReference Include="OpenIddict.Validation" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0010 — Quartz job-store schema applied by QuartzSchemaBootstrap. -->
    <EmbeddedResource Include="Scheduling\quartz_tables_postgres.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modgud.Domain\Modgud.Domain.csproj" />
    <ProjectReference Include="..\Modgud.Application\Modgud.Application.csproj" />
    <ProjectReference Include="..\Common\BuildingBlocks.EventDispatcher\BuildingBlocks.EventDispatcher.csproj" />
    <ProjectReference Include="..\Common\BuildingBlocks.Helper\BuildingBlocks.Helper.csproj" />
  </ItemGroup>

</Project>
