<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cocoar.Auth.Client.AspNetCore</RootNamespace>
    <Description>
      ASP.NET Core integration for Cocoar.Auth resource servers. Calls the
      IdP's distribution API (`/api/v1/distribution/me-permissions`) once
      per request, caches per (user, token, app) for 30s, and surfaces
      Roles/Permissions/Groups as flat claims so [Authorize(Roles="...")]
      and .RequiresCocoarPermission("...") work natively.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure permission-evaluator (realm:admin / resource:admin / exact-match
         tiers). Shared with the IdP server-side so both sides apply identical
         semantics. -->
    <ProjectReference Include="..\Cocoar.Auth.Permissions.Abstractions\Cocoar.Auth.Permissions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenIddict.Abstractions for the well-known JWT claim names
         (Claims.Subject, Claims.JwtId). Tiny, no transitive runtime deps. -->
    <PackageReference Include="OpenIddict.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cocoar.Auth.Tests.Unit" />
  </ItemGroup>

</Project>
