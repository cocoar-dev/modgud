{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Database=cocoar_auth;Username=postgres;Password=postgres"
  },
  "Auth": {
    "Cookie": {
      "HttpOnly": true,
      "SecurePolicy": "Always",
      "SameSite": "Lax"
    },
    "SessionExpirationDays": 14,
    "SlidingExpiration": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7054",
      "http://localhost:5128",
      "http://localhost:4200",
      "https://localhost:4200"
    ],
    "AllowCredentials": true,
    "AllowedMethods": [],
    "AllowedHeaders": []
  }
}
