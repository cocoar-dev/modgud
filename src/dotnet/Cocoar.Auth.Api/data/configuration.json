{
    "AllowedHosts": "*",
    "AppUrl": "http://localhost:9099",
    "CertPath": "",
    "CertPassword": "",
    "Logging": {
        "LogPath": "",
        "LogLevels": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "MagicLink": {
        "Enabled": true,
        "ExpirationMinutes": 15,
        "RateLimitMinutes": 2
    },
    "EmailOtp": {
        "ExpirationMinutes": 10,
        "RateLimitMinutes": 2,
        "MaxAttempts": 3
    },
    "Email": {
        "Provider": "Smtp",
        "Smtp": {
            "Host": "localhost",
            "Port": 2525,
            "FromAddress": "noreply@cocoar-auth.local",
            "FromName": "Cocoar.Auth"
        }
    },
    "AppSettings": {
        "AuthenticationMinimumLevel": 0,
        "MagicLinkSelfService": true,
        "TwoFactorGracePeriodDays": 14
    },
    "DbSettings": {
        "ConnectionString": "Host=localhost;Database=cocoar_auth;Username=postgres;Password=postgres"
    },
    "OpenIddict": {
        "Issuer": "http://localhost:9099",
        "DevelopmentMode": true,
        "AccessTokenLifetimeMinutes": 60,
        "RefreshTokenLifetimeDays": 14,
        "AuthorizationCodeLifetimeMinutes": 5
    },
    "Observability": {
        "ServiceName": "cocoar-auth",
        "SamplingRatio": 1.0,
        "Prometheus": {
            "Enabled": true,
            "Path": "/metrics",
            "BearerToken": ""
        },
        "Otlp": {
            "Enabled": false,
            "Endpoint": "http://localhost:4317",
            "Protocol": "Grpc"
        }
    }
}
