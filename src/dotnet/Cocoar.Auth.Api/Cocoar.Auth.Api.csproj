<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>affd5545-112b-4565-8201-1a534a20ce58</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cocoar.Auth.Api.Tests" />
    <InternalsVisibleTo Include="Cocoar.Auth.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <Content Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Cocoar.JsEval.TsDefinition" />
    <PackageReference Include="Cocoar.Reflectensions" />
    <PackageReference Include="Cocoar.SignalARRR.Server" />
    <PackageReference Include="Cocoar.Configuration" />
    <PackageReference Include="Cocoar.Configuration.AspNetCore" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="OpenIddict.Abstractions" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <!-- OpenTelemetry (Phase 1 foundation, see
         website/dev-notes/future-features/observability-opentelemetry.md). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cocoar.Auth.Infrastructure\Cocoar.Auth.Infrastructure.csproj" />
    <ProjectReference Include="..\Cocoar.Auth.Authentication\Cocoar.Auth.Authentication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="localhost.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    The Web SDK auto-includes every *.json under the project as Content with
    CopyToPublishDirectory=PreserveNewest. That means our dev-only "data/configuration.json"
    (and the gitignored "configuration.local.json") would end up in published images
    and silently override the secure class defaults of AppSettings. Exclude them from
    publish; devs still use them at source, prod runs on class defaults + env vars.

    data/demo-seed.json is dev-only fixture data (admin/Demo1234! plus hard-coded
    OAuth client secrets). After C16 the file is consumed by scripts/seed-demo.mjs
    (running outside the API as an admin client), so the in-process risk is gone
    — but we keep the file out of the publish output anyway so a leaked image
    doesn't carry the well-known fixture-secret list.
  -->
  <ItemGroup>
    <Content Update="data\configuration.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="data\configuration.local.json" Condition="Exists('data\configuration.local.json')">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="data\demo-seed.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot" />
  </ItemGroup>

</Project>
