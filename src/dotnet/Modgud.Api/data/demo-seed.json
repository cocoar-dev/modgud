      "membershipScript": "(p) => Type.Is(p, 'person') && p.IsActive && (p.Email != null) && !p.Email.endsWith('@demo.local')"
    },

    { "// smoke-test groups": "Bind the smoke-test users to their roles. BoundTo=[*] so they apply for every app the role's AppId points at." },

    {
      "name": "Smoke Test — Alice (Blog Writer)",
      "description": "alice has alpha-blog-writer grants only.",
      "members": ["alice"],
      "roles": ["alpha-blog-writer"],
      "boundTo": ["*"]
    },
    {
      "name": "Smoke Test — Bob (Realm Admin)",
      "description": "bob has the IsRealmAdmin role — pre-expansion will fill EVERY block.",
      "members": ["bob"],
      "roles": ["smoke-test-realm-admin"],
      "boundTo": ["*"]
    },
    {
      "name": "Smoke Test — Charlie (Beta Shop Admin)",
      "description": "charlie has resource-admin on every beta-shop resource — pre-expansion fills the catalog.",
      "members": ["charlie"],
      "roles": ["beta-shop-admin"],
      "boundTo": ["*"]
    },
    { "// diana": "diana has NO group — she's the pure-auth WordPress-class user. UserInfo emits empty resource_access for her tokens." },
    {
      "name": "Smoke Test — Eve (Cross-App User)",
      "description": "eve has grants in alpha-blog + beta-shop + gamma-crm.",
      "members": ["eve"],
      "roles": ["alpha-blog-writer", "beta-orders-clerk", "gamma-crm-user"],
      "boundTo": ["*"]
    },
    {
      "name": "Smoke Test — Morgan (Resource-Admin Moderator)",
      "description": "morgan only holds comment:admin — UserInfo will pre-expand to all comment:* (read+write+admin) but NOT touch post:*.",
      "members": ["morgan"],
      "roles": ["alpha-blog-comment-admin"],
      "boundTo": ["*"]
    },
    {
      "name": "Smoke Test — Nico (Partner Tracker)",
      "description": "nico is a logistics partner with shipment:read + shipment:track only. Demonstrates a narrow per-resource subset.",
      "members": ["nico"],
      "roles": ["beta-shipping-tracker"],
      "boundTo": ["*"]
    }
  ],

  "// scopes": "Each scope binds a token to a specific Audience via Resources=[<api-name>] and AppId=<app>. When a client requests this scope, the resulting access token's aud[] includes that audience.",
  "scopes": [
    { "name": "demo.read",  "displayName": "Demo API — Read",  "description": "Read access to the Demo API.",  "appKey": "demo-app", "resources": ["demo-api"] },
    { "name": "demo.write", "displayName": "Demo API — Write", "description": "Read+write access to the Demo API.", "appKey": "demo-app", "resources": ["demo-api"] },
    { "name": "demo.admin", "displayName": "Demo API — Admin", "description": "Administrative access to the Demo API.", "appKey": "demo-app", "resources": ["demo-api"] },

    { "// smoke-test scopes": "One scope per OAuthApi audience — keeps the wiring obvious." },

    { "name": "alpha-blog.use",     "displayName": "Alpha Blog — use",       "description": "Token grants access to the alpha-blog API.",     "appKey": "alpha-blog", "resources": ["https://alpha-blog-api.cocoar.local"] },
    { "name": "beta-orders.use",    "displayName": "Beta Shop — orders",     "description": "Token grants access to the beta-orders API.",    "appKey": "beta-shop",  "resources": ["https://beta-orders-api.cocoar.local"] },
    { "name": "beta-products.use",  "displayName": "Beta Shop — products",   "description": "Token grants access to the beta-products API.",  "appKey": "beta-shop",  "resources": ["https://beta-products-api.cocoar.local"] },
    { "name": "beta-shipping.use",  "displayName": "Beta Shop — shipping",   "description": "Token grants access to the beta-shipping API.",  "appKey": "beta-shop",  "resources": ["https://beta-shipping-api.cocoar.local"] },
    { "name": "beta-admin.use",     "displayName": "Beta Shop — admin",      "description": "Token grants access to the beta-admin API.",     "appKey": "beta-shop",  "resources": ["https://beta-admin-api.cocoar.local"] },
    { "name": "gamma-crm.use",      "displayName": "Gamma CRM — use",        "description": "Token grants access to the gamma-crm API.",      "appKey": "gamma-crm",  "resources": ["https://gamma-crm-api.cocoar.local"] }
  ],

  "// apis": "OAuthApi.AppId + OAuthApi.PermissionIds bind a resource server to its App's catalog. The RS authenticates against the distribution-API with name + initial secret to fetch the union of (its catalog subset) ∩ (user's grants).",
  "apis": [
    {
      "// demo-api note": "Bare-string aud — legal per RFC 7519 §2 (no colon, no URI required). Demonstrates the bare-identifier form alongside the URI form used by the smoke-test apis below.",
      "name": "demo-api",
      "displayName": "Demo API",
      "description": "Sample resource server consumed by the demo OAuth clients and the TestApps.ResourceApi.",
      "appKey": "demo-app",
      "scopes": ["demo.read", "demo.write", "demo.admin"],
      "permissions": [
        { "resource": "demo", "action": "read"  },
        { "resource": "demo", "action": "write" },
        { "resource": "demo", "action": "admin" }
      ]
    },

    { "// smoke-test apis": "alpha-blog: one RS for the whole catalog. beta-shop: 4 RSes, each with its own catalog subset. gamma-crm: one RS." },

    {
      "name": "https://alpha-blog-api.cocoar.local",
      "displayName": "Alpha Blog API",
      "description": "Single resource server for the alpha-blog app. Subset = full catalog.",
      "appKey": "alpha-blog",
      "scopes": ["alpha-blog.use"],
      "permissions": [
        { "resource": "post",     "action": "read"  },
        { "resource": "post",     "action": "write" },
        { "resource": "post",     "action": "admin" },
        { "resource": "comment",  "action": "read"  },
        { "resource": "comment",  "action": "write" },
        { "resource": "comment",  "action": "admin" },
        { "resource": "settings", "action": "admin" }
      ]
    },
    {
