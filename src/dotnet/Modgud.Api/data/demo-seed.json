  "// apps": "Each app has its own permission catalog. Roles FK into App.Permissions[].Id by (resource, action). The modgud app is seeded automatically — referenced here as @modgud via key (the seeder looks it up by slug rather than creating it).",
  "apps": [
    {
      "key": "demo-app",
      "slug": "demo-app",
      "displayName": "Demo App",
      "description": "Sample SaaS app demonstrating the Modgud permission model end-to-end.",
      "catalog": [
        { "resource": "demo", "action": "read",  "description": "Read demo resources" },
        { "resource": "demo", "action": "write", "description": "Modify demo resources" },
        { "resource": "demo", "action": "admin", "description": "Resource-wide admin bypass — covers read+write" }
      ]
    },

    { "// smoke-test apps": "Three apps in different shapes: a WordPress-class single-RS app (alpha-blog), a multi-microservice e-commerce app (beta-shop, 4 RSes), a single-mini-service CRM (gamma-crm)." },

    {
      "key": "alpha-blog",
      "slug": "alpha-blog",
      "displayName": "Alpha Blog",
      "description": "WordPress-class single-API app — pure auth + per-post gating. One App, one OAuthApi.",
      "catalog": [
        { "resource": "post",     "action": "read"  },
        { "resource": "post",     "action": "write" },
        { "resource": "post",     "action": "admin" },
        { "resource": "comment",  "action": "read"  },
        { "resource": "comment",  "action": "write" },
        { "resource": "comment",  "action": "admin" },
        { "resource": "settings", "action": "admin" }
      ]
    },
    {
      "key": "beta-shop",
      "slug": "beta-shop",
      "displayName": "Beta Shop",
      "description": "Multi-microservice e-commerce SaaS. One App, four OAuthApis (orders / products / shipping / admin), shared catalog. Demonstrates the per-RS catalog-subset story.",
      "catalog": [
        { "resource": "order",    "action": "read"  },
        { "resource": "order",    "action": "write" },
        { "resource": "order",    "action": "refund"},
        { "resource": "order",    "action": "admin" },
        { "resource": "product",  "action": "read"  },
        { "resource": "product",  "action": "write" },
        { "resource": "product",  "action": "admin" },
        { "resource": "shipment", "action": "read"  },
        { "resource": "shipment", "action": "write" },
        { "resource": "shipment", "action": "track" },
        { "resource": "shipment", "action": "admin" }
      ]
    },
    {
      "key": "gamma-crm",
      "slug": "gamma-crm",
      "displayName": "Gamma CRM",
      "description": "Single mini-service CRM — exemplary for a small consultancy SaaS. One App, one OAuthApi.",
      "catalog": [
        { "resource": "contact", "action": "read"  },
        { "resource": "contact", "action": "write" },
        { "resource": "contact", "action": "admin" },
        { "resource": "lead",    "action": "read"  },
        { "resource": "lead",    "action": "write" }
      ]
    }
  ],

  "// roles": "Each role names its app via appKey. permissions[] resolves to App.Permissions[].Id by (resource, action). isRealmAdmin: true is reserved for cross-realm bypass roles (the seeded System Admin handles that today).",
  "roles": [
    {
      "key": "oauth-admin",
      "name": "OAuth Admin",
      "description": "Full management of OAuth clients, scopes, APIs and login providers.",
      "appKey": "@modgud",
      "permissions": [
        { "resource": "oauth-client",    "action": "read"  },
        { "resource": "oauth-client",    "action": "write" },
        { "resource": "oauth-scope",     "action": "read"  },
        { "resource": "oauth-scope",     "action": "write" },
        { "resource": "oauth-api",       "action": "read"  },
        { "resource": "oauth-api",       "action": "write" },
        { "resource": "login-provider",  "action": "read"  },
        { "resource": "login-provider",  "action": "write" }
      ]
    },
    {
      "key": "group-admin",
      "name": "Group Admin",
      "description": "Manage authorization groups; read permission roles.",
      "appKey": "@modgud",
      "permissions": [
        { "resource": "authorization-group", "action": "read"  },
        { "resource": "authorization-group", "action": "write" },
        { "resource": "permission-role",     "action": "read"  }
      ]
    },
    {
      "key": "help-desk",
      "name": "Help Desk",
      "description": "Read-only access to users, sessions and the auth log.",
      "appKey": "@modgud",
      "permissions": [
        { "resource": "user",     "action": "read" },
        { "resource": "session",  "action": "read" },
        { "resource": "auth-log", "action": "read" }
      ]
    },
    {
      "key": "demo-reader",
      "name": "Demo Reader",
      "description": "Read access to the Demo App.",
      "appKey": "demo-app",
      "permissions": [
        { "resource": "demo", "action": "read" }
      ]
    },
    {
      "key": "demo-writer",
      "name": "Demo Writer",
      "description": "Read + write access to the Demo App.",
      "appKey": "demo-app",
      "permissions": [
        { "resource": "demo", "action": "read"  },
        { "resource": "demo", "action": "write" }
      ]
    },

    { "// smoke-test roles": "Mixed shapes — direct grants, resource-admin (will be pre-expanded), realm-admin." },

    {
      "key": "alpha-blog-writer",
      "name": "Alpha Blog Writer",
      "description": "Posts + reads comments on alpha-blog.",
      "appKey": "alpha-blog",
      "permissions": [
        { "resource": "post",    "action": "read"  },
        { "resource": "post",    "action": "write" },
        { "resource": "comment", "action": "read"  }
      ]
    },
    {
      "key": "alpha-blog-moderator",
      "name": "Alpha Blog Moderator",
      "description": "Resource-admin on post + comment — UserInfo will pre-expand to all post:* + comment:*.",
      "appKey": "alpha-blog",
      "permissions": [
        { "resource": "post",    "action": "admin" },
        { "resource": "comment", "action": "admin" }
      ]
    },
    {
      "key": "beta-orders-clerk",
      "name": "Beta Orders Clerk",
      "description": "Read-only on orders.",
      "appKey": "beta-shop",
      "permissions": [
        { "resource": "order", "action": "read" }
      ]
    },
    {
      "key": "beta-shop-admin",
      "name": "Beta Shop Admin",
      "description": "Resource-admin on every beta-shop resource — UserInfo will pre-expand to all order:*/product:*/shipment:*.",
      "appKey": "beta-shop",
      "permissions": [
        { "resource": "order",    "action": "admin" },
        { "resource": "product",  "action": "admin" },
        { "resource": "shipment", "action": "admin" }
      ]
    },
    {
      "key": "gamma-crm-user",
      "name": "Gamma CRM User",
      "description": "Read+write on contact + lead in gamma-crm.",
      "appKey": "gamma-crm",
      "permissions": [
        { "resource": "contact", "action": "read"  },
        { "resource": "contact", "action": "write" },
        { "resource": "lead",    "action": "read"  },
        { "resource": "lead",    "action": "write" }
      ]
    },
    {
      "key": "smoke-test-realm-admin",
      "name": "Smoke-Test Realm Admin",
      "description": "IsRealmAdmin role for the smoke-test bob user — bypass everywhere.",
      "isRealmAdmin": true
    },
    {
      "key": "beta-shipping-tracker",
      "name": "Beta Shipping Tracker",
      "description": "Read-only on shipments + the track action — partner-tier role.",
      "appKey": "beta-shop",
      "permissions": [
        { "resource": "shipment", "action": "read"  },
        { "resource": "shipment", "action": "track" }
      ]
    },
    {
      "key": "alpha-blog-comment-admin",
      "name": "Alpha Blog Comment Admin",
      "description": "Resource-admin only on comments — pre-expansion fills comment:* but NOT post:*.",
      "appKey": "alpha-blog",
      "permissions": [
        { "resource": "comment", "action": "admin" }
      ]
    }
  ],

  "groups": [
    {
      "name": "Demo Administrators",
