<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Modgud.Authentication</RootNamespace>
    <AssemblyName>Modgud.Authentication</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence + messaging -->
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx.Marten" />
    <!-- Marten 9.8+ bundles the JasperFx events source generator as an analyzer;
         a direct Marten ref runs it. The standalone package would double it
         (duplicate *.Evolver.g.cs -> CS0111), so it is intentionally omitted. -->

    <!-- FIDO2 / Passkey -->
    <PackageReference Include="Fido2.AspNet" />

    <!-- OIDC -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />

    <!-- SAML 2.0 SP federation (ITfoxtec, BSD-3-Clause) -->
    <PackageReference Include="ITfoxtec.Identity.Saml2" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" />

    <!-- Script evaluation for IdP user-update scripts -->
    <PackageReference Include="Cocoar.JsEval.Engine" />
    <PackageReference Include="Cocoar.JsEval.TsDefinition" />

    <!-- Optional<T>-aware JSON merge for profile change requests -->
    <PackageReference Include="Cocoar.Json.Mutable" />

    <!-- Auth log sink -->
    <PackageReference Include="Serilog.AspNetCore" />

    <!-- Per-user session device-info parsing (UA → browser/OS/device).
         HttpContext-bound — DeviceInfoService injects IDetectionService and
         only parses live during login (the single Parse call site). -->
    <PackageReference Include="Wangkanai.Detection" />

    <!-- Command return-types -->
    <PackageReference Include="ErrorOr" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modgud.Authorization\Modgud.Authorization.csproj" />
    <ProjectReference Include="..\Modgud.Domain\Modgud.Domain.csproj" />
    <ProjectReference Include="..\Modgud.Infrastructure\Modgud.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modgud.Tests.Unit" />
  </ItemGroup>

</Project>
