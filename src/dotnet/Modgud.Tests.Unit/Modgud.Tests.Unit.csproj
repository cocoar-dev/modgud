<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Modgud.Tests.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <!--
    Unit tests reference Domain + Application + Infrastructure + Api ONLY for the
    types of tiny stateless classes (e.g. middleware, helpers). They never spin up
    a WebApplicationFactory, Marten store, Testcontainer or Docker — pure logic only.
    `dotnet test src/dotnet/Modgud.Tests.Unit` should finish in well under a second.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Modgud.Domain\Modgud.Domain.csproj" />
    <ProjectReference Include="..\Modgud.Application\Modgud.Application.csproj" />
    <ProjectReference Include="..\Modgud.Authorization\Modgud.Authorization.csproj" />
    <ProjectReference Include="..\Modgud.Authentication\Modgud.Authentication.csproj" />
    <ProjectReference Include="..\Modgud.Api\Modgud.Api.csproj" />
    <ProjectReference Include="..\Modgud.Client.AspNetCore\Modgud.Client.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
