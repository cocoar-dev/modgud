{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.isolated.config.ts", "playwright.live-fixes.config.ts", "tests/browser/**/*.ts", "tests/live/**/*.ts"]
}
