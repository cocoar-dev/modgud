<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TimeToDo.Authorization</RootNamespace>
    <AssemblyName>TimeToDo.Authorization</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in ASP.NET Core types (IEndpointFilter, RouteHandlerBuilder, etc.)
         from the shared framework without making this a Web-host project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence + messaging — fix gesetzt für alle Konsumenten. -->
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx.Marten" />

    <!-- Script evaluation for access policies. -->
    <PackageReference Include="Cocoar.JsEval.Engine" />
    <PackageReference Include="Cocoar.JsEval.Linq" />
    <PackageReference Include="Cocoar.JsEval.TypeScript" />
    <PackageReference Include="Cocoar.JsEval.TsDefinition" />

    <!-- Command return-types (used by handlers). -->
    <PackageReference Include="ErrorOr" />

    <!-- Note: Microsoft.Extensions.DependencyInjection.Abstractions and
         Microsoft.Extensions.Logging.Abstractions are already provided by
         Microsoft.AspNetCore.App's shared framework — don't re-add them. -->
  </ItemGroup>

</Project>
